# Postgres (Neon pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Deep learning model endpoint (multipart/form-data /predict/frames) and timeout in ms
MODEL_URL="https://your-model-host.ngrok-free.dev/predict/frames"
MODEL_TIMEOUT_MS=30000

# Optional synchronous AI routes for other input types
MODEL_VIDEO_URL="https://your-model-host.ngrok-free.dev/predict/video"
MODEL_VIDEO_LANDMARKS_URL="https://your-model-host.ngrok-free.dev/predict/video-landmarks"
MODEL_LANDMARKS_URL="https://your-model-host.ngrok-free.dev/predict/tcn-landmarks"

# Redis (optional on serverless — falls back to in-memory buffer if omitted or unreachable)
# Preferred for hosted Redis (e.g. Upstash):
REDIS_URL=
# Or host/port/password for local Redis:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server settings (local development)
PORT=3000
NODE_ENV=production
BODY_LIMIT=10mb
